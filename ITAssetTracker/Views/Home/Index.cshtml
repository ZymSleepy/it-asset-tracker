@{
    ViewData["Title"] = "Dashboard";
}

<div class="text-center">
    <h1 class="display-4">IT Asset & Ticket Dashboard</h1>
</div>

<div class="row mt-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary mb-3">
            <div class="card-body">
                <h5 class="card-title">Total Assets</h5>
                <p class="card-text display-6">@ViewData["TotalAssets"]</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success mb-3">
            <div class="card-body">
                <h5 class="card-title">Available Assets</h5>
                <p class="card-text display-6">@ViewData["AvailableAssets"]</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning mb-3">
            <div class="card-body">
                <h5 class="card-title">Open Tickets</h5>
                <p class="card-text display-6">@ViewData["OpenTickets"]</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-secondary mb-3">
            <div class="card-body">
                <h5 class="card-title">Total Tickets</h5>
                <p class="card-text display-6">@ViewData["TotalTickets"]</p>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <a asp-controller="Assets" asp-action="Index" class="btn btn-outline-primary">View Assets</a>
    <a asp-controller="Tickets" asp-action="Index" class="btn btn-outline-primary">View Tickets</a>
</div>